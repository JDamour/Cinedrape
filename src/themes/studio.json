{
  "schema": 1,
  "id": "studio",
  "name": "Studio",
  "author": "Cinedrape",
  "version": "1.0.0",
  "tier": "free",
  "tokens": {
    "color": {
      "bg": "#faf7f2",
      "surface": "#ffffff",
      "text": "#181512",
      "muted": "#605850",
      "accent": "#a8381a",
      "border": "#8c8278"
    },
    "type": {
      "family": "Inter",
      "baseSize": 15,
      "headingWeight": 600
    },
    "shape": {
      "radius": 14,
      "shadow": true,
      "spacing": 5
    }
  },
  "layout": {
    "home": "hero-rows",
    "watch": "focus",
    "density": 4
  },
  "calm": {
    "hideShorts": true
  },
  "css": "[cd-theme]{--cd-heading-font:Georgia,'Times New Roman',serif}\n.cd-home{padding-inline:calc(var(--cd-space) * 5)}\n.cd-hero-title{font-family:var(--cd-heading-font);font-size:2.2em}\n.cd-row-title{font-family:var(--cd-heading-font);font-size:1.6em;border-bottom:2px solid var(--cd-accent)}\n.cd-card:hover .cd-card-thumb{transform:translateY(-3px);border-color:var(--cd-accent)}"
}
