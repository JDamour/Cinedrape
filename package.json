{
  "name": "cinedrape",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Cinedrape: themes, layouts and calm mode for YouTube (Manifest V3 Chrome extension).",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "build:strict": "node build.mjs --strict",
    "build:firefox": "node build.mjs --strict --target firefox",
    "build:edge": "node build.mjs --strict --target edge",
    "build:all": "node build.mjs --strict --target chrome && node build.mjs --strict --target edge && node build.mjs --strict --target firefox",
    "test": "node --test --test-concurrency=6 \"test/**/*.test.js\"",
    "keys": "node tools/gen-keys.mjs",
    "sign-map": "node tools/sign-map.mjs",
    "licence:dev": "node tools/dev-licence.mjs",
    "licence:mint": "node tools/mint-licence.mjs",
    "e2e": "node test/e2e/run.mjs",
    "e2e:home": "node test/e2e/features-home-calm.mjs --extension dist-home",
    "e2e:popup": "node test/e2e/features-popup-breakage.mjs --extension dist-popup",
    "package": "node tools/package.mjs --allow-dev-keys",
    "package:firefox": "node tools/package.mjs --target firefox --allow-dev-keys",
    "package:edge": "node tools/package.mjs --target edge --allow-dev-keys",
    "package:all": "node tools/package.mjs --all --allow-dev-keys",
    "og-banner": "node tools/make-og-banner.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.12.0"
  },
  "engines": {
    "node": ">=22"
  }
}
